# Public Sepolia configuration. Mainnet is intentionally unsupported.
NEXT_PUBLIC_STARKNET_NETWORK=sepolia
NEXT_PUBLIC_STARKNET_CHAIN_ID=SN_SEPOLIA
NEXT_PUBLIC_STARKNET_EXPLORER=https://sepolia.voyager.online
NEXT_PUBLIC_ARTICLE_REGISTRY_ADDRESS=
NEXT_PUBLIC_STRK20_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
NEXT_PUBLIC_TIP_INBOX_ADDRESS=
NEXT_PUBLIC_EDITORIAL_ENCRYPTION_PUBLIC_JWK=
NEXT_PUBLIC_EDITORIAL_RECIPIENT_TAG=

# Server-only Starknet configuration.
STARKNET_SEPOLIA_RPC_URL=
STARKNET_PUBLISHER_ADDRESS=
STARKNET_PUBLISHER_PRIVATE_KEY=

# Reclaim secrets stay on the server.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_ID=
# Optional. Pin the provider template hash that appears in proof context as providerHash.
RECLAIM_PROVIDER_HASH=

# Google receives interview and article text when this key is configured.
GEMINI_API_KEY=

# Session and rate-limit secrets must be independent random values.
SESSION_SECRET=
RATE_LIMIT_SECRET=
SESSION_STORE_PATH=.data/sessions.json

# Development only. Never enable this in a public deployment.
ALLOW_DEV_WITHOUT_PRIVATE_BOND=false
