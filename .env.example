# Public Sepolia configuration. Mainnet is intentionally unsupported.
NEXT_PUBLIC_STARKNET_NETWORK=sepolia
NEXT_PUBLIC_STARKNET_CHAIN_ID=SN_SEPOLIA
NEXT_PUBLIC_STARKNET_EXPLORER=https://sepolia.voyager.online
NEXT_PUBLIC_ARTICLE_REGISTRY_ADDRESS=0x2be142c378dbf4f9480196d484b9e22363887ef523ee3cde332a4fa2fe4f6f0
NEXT_PUBLIC_STRK20_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
NEXT_PUBLIC_TIP_INBOX_ADDRESS=
NEXT_PUBLIC_EDITORIAL_ENCRYPTION_PUBLIC_JWK=
NEXT_PUBLIC_EDITORIAL_RECIPIENT_TAG=

# Server-only Starknet configuration.
STARKNET_SEPOLIA_RPC_URL=
STARKNET_PUBLISHER_ADDRESS=
STARKNET_PUBLISHER_PRIVATE_KEY=

# Reclaim secrets stay on the server.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_ID=
# Optional. Pin the provider template hash that appears in proof context as providerHash.
RECLAIM_PROVIDER_HASH=

# AI backend. Default is the local open model through Ollama (no key, text stays on this server).
# Install: brew install ollama && brew services start ollama && ollama pull qwen2.5:7b
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Attested confidential inference (AI_PROVIDER=phala, preferred when set). This server verifies
# Phala's Intel TDX attestation with @phala/aci-verifier before sending any text and audits the
# signed receipt of every reply. Key from https://cloud.phala.com. Model list: GET https://inference.phala.com/v1/models
PHALA_API_KEY=
PHALA_MODEL=deepseek/deepseek-v3.2
PHALA_BASE_URL=https://inference.phala.com/v1
# Optional comma-separated sha256(app_compose) values you reviewed; empty means measured but not release-pinned.
PHALA_ACCEPTED_COMPOSE_HASHES=
# Hosted open model for deployments (AI_PROVIDER=openrouter), pinned to Phala's GPU TEE endpoints.
# OpenRouter and Phala receive the text. No attestation is passed through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_PROVIDER=phala
# Optional external backend. Google receives interview and article text when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Session and rate-limit secrets must be independent random values.
SESSION_SECRET=
RATE_LIMIT_SECRET=
SESSION_STORE_PATH=.data/sessions.json
# Hosted deployments: Neon Postgres connection string. When set, it replaces the file store.
SESSION_STORE_URL=

# Development only. Never enable this in a public deployment.
ALLOW_DEV_WITHOUT_PRIVATE_BOND=false
