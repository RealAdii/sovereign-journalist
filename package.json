{
  "name": "sovereign-journalist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "cd contracts && snforge test",
    "check:sepolia": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/check-sepolia.mts",
    "build:contracts": "cd contracts && scarb build",
    "deploy:sepolia": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/deploy-sepolia.mts",
    "benchmark:sepolia": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/benchmark-articles.mts",
    "readback:sepolia": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/readback-verify.mts",
    "check:dashes": "node scripts/check-dashes.mjs",
    "test:e2e": "playwright test",
    "dev:capability": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/issue-dev-capability.mts",
    "bond:setup": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/bond-setup.mts",
    "bond:linkage": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/bond-linkage-check.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@phala/aci-verifier": "0.7.2",
    "@reclaimprotocol/js-sdk": "5.8.2",
    "@starknet-io/get-starknet-discovery": "6.0.3",
    "@starknet-io/get-starknet-wallet-standard": "6.0.3",
    "@starknet-io/types-js": "0.10.3",
    "@starkware-libs/starknet-privacy-sdk": "file:vendor/starkware-libs-starknet-privacy-sdk-0.14.3-rc.8.tgz",
    "@tailwindcss/typography": "^0.5.19",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "starknet": "10.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
