   "isDeleted": false,
   "boundElements": [],
   "updated": 1790625469148,
   "link": null,
   "locked": false,
   "text": "Your Ready wallet sends 1 STRK plus a tiny per-session amount\nthrough the STRK20 pool to our treasury. Nothing public names\nyou. Blocked right now: the Sepolia prover speaks PROOF1, the\npool accepts PROOF0 (StarkWare version mismatch).",
   "originalText": "Your Ready wallet sends 1 STRK plus a tiny per-session amount\nthrough the STRK20 pool to our treasury. Nothing public names\nyou. Blocked right now: the Sepolia prover speaks PROOF1, the\npool accepts PROOF0 (StarkWare version mismatch).",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "baseline": 13,
   "containerId": null,
   "autoResize": false
  },
