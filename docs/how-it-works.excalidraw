   "isDeleted": false,
   "boundElements": [],
   "updated": 1790618876852,
   "link": null,
   "locked": false,
   "text": "An AI running on our own computer asks\nyou questions, one at a time.\nNothing is sent to Google or any outside\ncompany. The people running the server\ncould read it, and we say so.",
